# ============================================================
# 多人知识协作智能 Web 平台 - 后端配置模板（入库；真实密钥只写 .env）
# ============================================================

# PostgreSQL 连接串
DATABASE_URL="postgresql://postgres:demo@localhost:5432/collab_platform?schema=public"

# JWT 签名密钥
JWT_SECRET="change-me-to-a-long-random-string"

# LLM 服务商密钥（只存后端，绝不出现在前端）
LLM_API_KEY=""

# LLM 端点（换模型只改这里，DeepSeek-V3 默认）
LLM_BASE_URL="https://api.deepseek.com/v1/chat/completions"
LLM_MODEL="deepseek-chat"

# mock 模式：true 时不调用真实 LLM，2s 内返回假流式输出（演示彩排必跑）
LLM_MOCK="false"

# 文件落盘目录
UPLOAD_DIR="./uploads"

# 后端端口
PORT=3001

# 生产环境允许访问 API 的前端来源；多个来源用英文逗号分隔。
CORS_ORIGIN="http://localhost:8080"

# ============================================================
# 联网学术检索（arXiv + OpenAlex）
# ============================================================
# 默认检索源（逗号分隔）；内网/离线环境 arXiv 不可达时改为 openalex
ACADEMIC_SOURCES="arxiv,openalex"

# 单请求超时（毫秒）；源被墙时调小避免每次白等
ACADEMIC_TIMEOUT_MS=10000
